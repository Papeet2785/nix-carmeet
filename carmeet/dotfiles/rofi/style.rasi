configuration {
    show-icons:                     false;
    display-drun:                   "";
    drun-display-format:            "{name}";
    disable-history:                false;
    click-to-exit:                  true;
    location:                       0;
}
* {
    font: "Comfortaa 12";
    BG:    #282828;
    BGA:   #ebdbb2;
    FG:    #fbf1c7;
    FGA:   #F28FAD;
    UGT:   #F28FAD;
    IMG:   #FAE3B0;
    OFF:   #abb2bf;
    ON:    #ABE9B3;
}
window {
    transparency:                   "real";
    background-color:               @BG;
    text-color:                     @FG;
    border:                         2px;
    border-color:                   @BGA;
    border-radius:                  6px;
    width:                          20%;
    anchor:                         center;
    x-offset:                       0;
    y-offset:                       0;
}
textbox-prompt-colon {
    expand: false;
    str: "";
    border-radius: 0px;
    background-color: #282c34;
    text-color: transparent;
    padding: 0px;
    font: "Comfortaa 10";
    width: 0px;
}
entry {
    background-color:               @BG;
    text-color:                     @FG;
    expand:                         true;
    horizontal-align:               0;
    blink:                          true;
    border:                         3px;
    border-color:                   @BGA;
    border-radius:                  5px;
    padding:                        8px;
}
inputbar {
    children:                       [ textbox-prompt-colon, entry ];
    background-color:               @BG;
    text-color:                     @FG;
    expand:                         false;
    border:                         1px;
    border-radius:                  5px;
    border-color:                   @BG;
    margin:                         0px;
    padding:                        0px;
    position:                       center;
}
listview {
    background-color:               @BG;
    columns:                        1;
    lines:                          4;
    spacing:                        7px;
    cycle:                          false;
    dynamic:                        true;
    layout:                         vertical;
}
scrollbar {
    border:                         0px;
    border-radius:                  5px;
    background-color:               @BG;
    handle-color:                   @BGA;
    handle-width:                   2px;
    padding:                        0;
}
mainbox {
    background-color:               @BG;
    children:                       [ inputbar, message, listview ];
    spacing:                        15px;
    padding:                        15px;
}
element {
    background-color:               #504945;
    text-color:                     @FG;
    orientation:                    horizontal;
    padding:                        12px;
    border-radius:                  5px;
    border:                         0px 0px 8px 0px;
    border-color:                   #403834;
}
element-text {
    background-color:               #504945;
    text-color:                     @FG;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         2px 0px 2px 2px;
}
element-text selected {
    background-color:               #b8bb26;
    text-color:                     #282828;
}
element selected {
    background-color:               #b8bb26;
    border-radius:                  6px;
    border:                         0px 0px 8px 0px;
    border-color:                   #98971a;
}
